{# Display only; searching and all controls belong to Survos SearchBundle. #}
<article class="card">
    <div class="card-body">
        <h2 class="card-title"><a href="{{ path('song_show', {songId: hit.id}) }}">{{ hit.title }}</a></h2>
        <p class="text-muted">{{ hit.school|default('') }}{% if hit.year|default(null) %} · {{ hit.year }}{% endif %}</p>
        {% set lyricsLength = hit.lyrics|default('')|trim|length %}
        <p class="small mb-0 {{ lyricsLength ? 'text-success' : 'text-muted' }}">
            {% if lyricsLength %}Lyrics: {{ lyricsLength|number_format }} characters{% else %}Lyrics missing{% endif %}
        </p>
    </div>
</article>
