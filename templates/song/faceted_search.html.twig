{% extends 'base.html.twig' %}
{% block title %}Search songs{% endblock %}
{% block page_title 'Search songs' %}
{% block page_subtitle 'Kid Pan Alley catalog' %}
{% block body %}
    <p><a href="{{ path('app_homepage') }}">← About the archive</a></p>
    <p class="text-muted">Explore the loaded catalog by title, lyrics, school, or year. The archive is still being assembled and checked.</p>
    <twig:Survos:Search:Layout name="app_song" :initialQuery="{query: app.request.query.get('q', '')}" :urlRewriting="true" />
{% endblock %}
