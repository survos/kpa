{% extends 'archive.html.twig' %}
{% block title %}Search songs · Kid Pan Alley{% endblock %}
{% block body %}
<section class="search-heading"><p class="eyebrow">The song archive</p><h1>Find your next <em>discovery.</em></h1><p>Look for a title, a line you remember, or an idea you’re curious about.</p></section>
<form method="get" action="{{ path('song_search') }}" class="search-form">
    <label for="song-query">Search the archive</label>
    <div class="search-controls"><input id="song-query" type="search" name="q" value="{{ q }}" maxlength="500" placeholder="Try friendship, a school, or a song title">
    <label class="sr-only" for="song-mode">Search mode</label>
    <select id="song-mode" name="mode">{% for value, label in (aiEnabled ? {lexical: 'Keyword', semantic: 'Semantic', hybrid: 'Hybrid', compare: 'Compare all three'} : {lexical: 'Keyword'}) %}<option value="{{ value }}" {{ mode == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>
    <button class="button">Search <span aria-hidden="true">→</span></button></div>
    <p class="search-help">{% if aiEnabled %}Keyword finds matching words. Semantic explores meaning. Hybrid combines both.{% else %}Keyword searches titles, lyrics, and catalog details. Semantic and hybrid search are coming soon.{% endif %}</p>
</form>
<div class="results {{ mode == 'compare' ? 'results-compare' : '' }}">
{% for name, result in results %}
<section class="result-column" aria-label="{{ name }} results"><div class="results-heading"><h2>{{ q ? 'Results for “' ~ q ~ '”' : 'Explore the collection' }}</h2><span>{{ {lexical: 'Keyword', semantic: 'Semantic', hybrid: 'Hybrid'}[name] }} · {{ result.totalResults|number_format }} songs</span></div>
{% for hit in result.hits %}{% set song = hit.data %}{% set excerpt = excerpts[song.id]|default('') %}
<article class="song-result"><span class="result-number" aria-hidden="true">{{ '%02d'|format((page - 1) * 12 + loop.index) }}</span><div><p class="song-meta">{{ song.school ?: 'Kid Pan Alley' }}{% if song.year %} · {{ song.year }}{% endif %}</p><h3><a href="{{ path('song_show', {songId: song.id}) }}">{{ song.title }}</a></h3><p class="excerpt">{{ excerpt ? excerpt|slice(0, 260) ~ (excerpt|length > 260 ? '…' : '') : 'Lyrics are not yet available for this song.' }}</p></div><a class="song-arrow" href="{{ path('song_show', {songId: song.id}) }}" aria-label="Read {{ song.title }}">↗</a></article>
{% else %}<div class="empty-state"><h3>No songs found just yet.</h3><p>Try fewer words, a different spelling, or a broader topic.</p><a href="{{ path('song_search') }}">Browse the collection →</a></div>{% endfor %}
{% if mode != 'compare' and (page > 1 or result.totalResults > page * 12) %}<nav class="pagination" aria-label="Search result pages">{% if page > 1 %}<a href="{{ path('song_search', {q: q, mode: mode, page: page - 1}) }}">← Previous</a>{% endif %}<span>Page {{ page }}</span>{% if result.totalResults > page * 12 and page < 100 %}<a href="{{ path('song_search', {q: q, mode: mode, page: page + 1}) }}">Next →</a>{% endif %}</nav>{% endif %}
</section>{% endfor %}
</div>
{% endblock %}
