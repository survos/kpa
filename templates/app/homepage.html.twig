{% extends 'archive.html.twig' %}
{% block body %}
<section class="hero">
    <div>
        <p class="eyebrow">A collection of shared imagination</p>
        <h1>Small voices.<br>Big ideas.<br><em>Wonderful songs.</em></h1>
        <p class="hero-copy">Welcome to the Kid Pan Alley archive. Discover songs created with children, songwriters, schools, and communities—each one a little piece of the world as they see it.</p>
        <a class="button" href="{{ path('song_search') }}">Explore the songs <span aria-hidden="true">→</span></a>
    </div>
    <div class="songbook" aria-hidden="true"><div class="songbook-label">KID PAN ALLEY<br>THE COLLECTED SONGS</div><div class="staff">♪<span>♫</span>♪</div><div class="songbook-title">A world of stories,<br>one song at a time.</div><div class="songbook-bottom">WORDS · MUSIC · IMAGINATION <span>↗</span></div></div>
</section>
<section class="archive-stats" aria-label="Archive at a glance"><div><strong>{{ stats.songs|number_format }}</strong><span>songs in the catalog</span></div><div><strong>{{ stats.lyrics|number_format }}</strong><span>songs with lyrics to explore</span></div><p>A growing record of creativity.<br>Preserved for discovery.</p></section>
<section class="about-grid"><div><p class="eyebrow">Inside the archive</p><h2>Find a familiar song.<br>Discover a new perspective.</h2></div><div><p>From friendship and belonging to nature and everyday adventures, these songs give children’s ideas a place to be heard.</p><p>Explore song titles and lyrics, along with the schools, years, and songwriting credits recorded in the catalog. The collection brings together the master song list and original lyric documents; some songs are still awaiting their lyrics.</p><a class="text-link" href="{{ path('song_search') }}">Start your search <span aria-hidden="true">→</span></a></div></section>
<section class="browse-topics"><p class="eyebrow">A few places to begin</p><div>{% for topic in ['Friendship', 'Dreams', 'Family', 'Nature'] %}<a href="{{ path('song_search', {q: topic}) }}">{{ topic }} <span aria-hidden="true">↗</span></a>{% endfor %}</div></section>
{% endblock %}
