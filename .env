# AGENTS!! use bin/console debug:dotenv instead of reading this file.

# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices/configuration.html#infrastructure-related-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=APP_$SECRET
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DBNAME=kpa
DATABASE_URL=postgresql://postgres:docker@127.0.0.1:5434/kidpanalley?serverVersion=18&charset=utf8
###< doctrine/doctrine-bundle ###

###> symfony/swiftmailer-bundle ###
# For Gmail as a transport, use: "gmail://username:password@localhost"
# For a generic SMTP server, use: "smtp://localhost:25?encryption=&auth_mode="
# Delivery is disabled by default via "null://localhost"
MAILER_URL=null://localhost
###< symfony/swiftmailer-bundle ###

# survos/wordpress-bundle -- see config/packages/survos_wordpress.yaml.
# API_PASSWORD is an Application Password (Users -> Profile), not the account password;
# it belongs in .env.local, never here.
WORDPRESS_BASE_URL=https://www.kidpanalley.org
API_USERNAME=
API_PASSWORD=
###> google/apiclient ###
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_CONFIG=%kernel.project_dir%/path/to/file.json
###< google/apiclient ###

YOUTUBE_CHANNEL=UCt7IqS6nJWbJk6HByzJs5Tg
YOUTUBE_API_KEY=

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(kpa.wip|localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

OAUTH_GITHUB_CLIENT_ID=~
OAUTH_GITHUB_CLIENT_SECRET=~

OAUTH_FACEBOOK_CLIENT_ID=~
OAUTH_FACEBOOK_CLIENT_SECRET=~

OAUTH_GOOGLE_CLIENT_ID=~
OAUTH_GOOGLE_CLIENT_SECRET=~

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
#MESSENGER_TRANSPORT_DSN_RABBITMQ=phpamqplib://guest:guest@localhost:5672/kpa

#MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/kpa
###< symfony/messenger ###


###> sentry/sentry-symfony ###
SENTRY_DSN=
###< sentry/sentry-symfony ###


OAUTH_DROPBOX_CLIENT_ID=
OAUTH_DROPBOX_CLIENT_SECRET=

###> inspector-apm/inspector-symfony ###
INSPECTOR_INGESTION_KEY=
###< inspector-apm/inspector-symfony ###

DEFAULT_TRANSPORT=async
###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

### .env in kpa
###> whisper.cpp ###
WHISPER_CLI=
WHISPER_MODEL=
WHISPER_OUTPUT_DIR=var/whisper
###< whisper.cpp ###

###> audio lyrics/musicxml ###
BASIC_PITCH_BIN=
DEMUCS_BIN=
MUSICXML_PYTHON=
MUSICXML_SCRIPT=
###< audio lyrics/musicxml ###

###> survos/storage-bundle ###
STORAGE_API_KEY=
###< survos/storage-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=kpa-songs
# Optional key prefix within the bucket; the FileAsset workflow self-namespaces under mp3/
S3_STORAGE_PREFIX=

###> survos/elastic-bundle ###
ELASTICSEARCH_DSN=elasticsearch://127.0.0.1:9200
###< survos/elastic-bundle ###

# Same local embedding provider/model as Ink and Folio. Revision pins the installed model digest.
KPA_OLLAMA_URL=http://127.0.0.1:11434/
KPA_EMBED_MODEL=nomic-embed-text:latest
KPA_EMBED_REVISION=0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f

# Embedding generation and semantic/hybrid song search (resumed 2026-11-23 for themed episodes).
KPA_AI_ENABLED=1
# The song vector cache (survos/ai-embed-bundle). Keep it on persistent storage; other checkouts can point here.
AI_EMBED_CACHE=%kernel.project_dir%/var/embeddings/kpa.duckdb
# Shared vector storage (Hetzner object storage, like harvest and packages): song vectors made on a
# workstation are pushed here (app:songs:vectors:export --push) and production imports them.
EMBEDDINGS_S3_BUCKET=survos-embeddings
EMBEDDINGS_S3_REGION=fsn1
EMBEDDINGS_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# keys in .env.local / the deployment's config, never here
EMBEDDINGS_S3_ACCESS_KEY=
EMBEDDINGS_S3_SECRET_KEY=

###> symfony/ai-generic-platform ###
# GENERIC_BASE_URL=https://api.example.com/v1
###< symfony/ai-generic-platform ###

###> symfony/ai-mistral-platform ###
MISTRAL_API_KEY=
###< symfony/ai-mistral-platform ###

# Themed episodes (src/Episode/): the script writer, pinned (Mistral's -latest aliases can point to older models)
EPISODE_WRITER_MODEL=mistral-medium-2604

###> kpa chat and MCP ###
KPA_PUBLIC_URL=https://kpa.survos.com
KPA_CHAT_MODEL=mistral-medium-2604
###< kpa chat and MCP ###
KPA_VOICE_MODEL=voxtral-mini-tts-3-0
KPA_EPISODES_DIR=%kernel.project_dir%/var/episodes
TRUSTED_PROXIES=PRIVATE_SUBNETS
